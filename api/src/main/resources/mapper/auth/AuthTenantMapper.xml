<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gba.merchantbao.auth.mapper.AuthTenantMapper">
  <select id="findActiveByCode" resultType="com.gba.merchantbao.auth.entity.Tenant" flushCache="true" useCache="false">
    SELECT id, merchant_code FROM merchant WHERE merchant_code = #{merchantCode} AND status = 'ACTIVE'
  </select>
  <select id="findActiveById" resultType="com.gba.merchantbao.auth.entity.Tenant" flushCache="true" useCache="false">
    SELECT id, merchant_code FROM merchant WHERE id = #{merchantId} AND status = 'ACTIVE'
  </select>
</mapper>
