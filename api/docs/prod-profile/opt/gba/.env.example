MYSQL_ROOT_PASSWORD=REPLACE_WITH_ROOT_PASSWORD
FLYWAY_PASSWORD=REPLACE_WITH_MIGRATION_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_APPLICATION_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
# Two different Base64 keys, each decoding to at least 32 random bytes.
# Run openssl rand -base64 32 twice. ADMIN means MERCHANT_STAFF, not MySQL root.
ADMIN_JWT_SECRET=REPLACE_WITH_MERCHANT_STAFF_BASE64_KEY
USER_JWT_SECRET=REPLACE_WITH_CONSUMER_BASE64_KEY
# Snowflake worker 0-1023; assign a distinct value to every live app instance, including rolling deployments.
MERCHANT_ID_WORKER_ID=0
APP_VERSION=manual-1
APP_PORT=8080
