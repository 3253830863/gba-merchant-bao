{
  "info": {
    "name": "Agent 受控模型验收（本机隔离）",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "导入 Apifox 后运行01–14。只允许独立 AgentApifoxWorkspace；fixtureUrl 从本机忽略文件设置。临时登录 token 每个请求由本机 fixture 获取，只存 pm.variables，不保存共享变量。busy/客户端中止另按文档人工验证。未执行不代表通过。"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const fixtureUrl=pm.variables.get('fixtureUrl');",
          "const fixtureAddress=new URL(fixtureUrl||'http://invalid');",
          "if(fixtureAddress.protocol!=='http:' || fixtureAddress.hostname!=='127.0.0.1' || !fixtureAddress.pathname.startsWith('/fixture/')) throw new Error('Set the local disposable fixtureUrl first');",
          "pm.sendRequest(fixtureUrl,function(error,response){if(error||response.code!==200)throw new Error('Local fixture unavailable');const fixture=response.json();for(const [key,value] of Object.entries(fixture)){if(!['sessionId'].includes(key))pm.variables.set(key,value);}});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 创建本人会话",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Accept",
            "value": "text/event-stream, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Request-Id",
            "value": "apifox-agent-acceptance"
          }
        ],
        "url": "{{baseUrl}}/api/v1/chat/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Apifox controlled acceptance\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('normalKey',pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const data=pm.response.json().data; pm.variables.set('sessionId',data.sessionId); pm.test(\"String session ID\", function () { pm.expect(data.sessionId).to.match(/^[1-9][0-9]*$/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 本人会话列表",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Accept",
            "value": "text/event-stream, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Request-Id",
            "value": "apifox-agent-acceptance"
          }
        ],
        "url": "{{baseUrl}}/api/v1/chat/sessions?size=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Created session appears\", function () { pm.expect(pm.response.json().data.items.map(x=>x.sessionId)).to.include(pm.variables.get('sessionId'));  });"
            ]
          }
        }
      ]
    },
