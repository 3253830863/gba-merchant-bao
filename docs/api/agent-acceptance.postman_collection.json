    {
      "name": "08 同租户员工不能读取本人会话",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          },
          {
            "key": "Accept",
            "value": "text/event-stream, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Request-Id",
            "value": "apifox-agent-acceptance"
          }
        ],
        "url": "{{baseUrl}}/api/v1/chat/sessions/{{sessionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
              "",
              "for(const operation of [{method:'GET',suffix:'/messages'},{method:'POST',suffix:'/archive'},{method:'POST',suffix:'/messages',body:{mode:'raw',raw:JSON.stringify({content:'forbidden',clientMessageId:pm.variables.replaceIn('{{$guid}}')})}}]) {",
              "pm.sendRequest({url:pm.variables.get('baseUrl')+'/api/v1/chat/sessions/'+pm.variables.get('sessionId')+operation.suffix,method:operation.method,header:{Authorization:'Bearer '+pm.variables.get('staffToken'),'Content-Type':'application/json'},body:operation.body},function(error,response){pm.test('staffToken '+operation.method+' '+operation.suffix+' 404',function(){pm.expect(error).to.equal(null);pm.expect(response.code).to.equal(404);});});",
              "}"
            ]
          }
        }
      ]
    },
