        "url": "{{baseUrl}}/api/v1/chat/sessions/{{sessionId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\"content\":\"new\",\"clientMessageId\":\"{{caseKey}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('caseKey',pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });",
              "pm.test(\"Archived business code\", function () { pm.expect(pm.response.json().code).to.equal(13004); });"
            ]
          }
        }
      ]
    }
  ]
}
