    {
      "name": "04 正常 SSE 与 MySQL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Accept",
            "value": "text/event-stream, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Request-Id",
            "value": "apifox-agent-acceptance"
          }
        ],
        "url": "{{baseUrl}}/api/v1/chat/sessions/{{sessionId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\"content\":\"hello\",\"clientMessageId\":\"{{normalKey}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "",
              "pm.test('SSE MIME',function(){pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');});",
              "const raw=pm.response.text().replace(/\\r\\n/g,'\\n');",
              "const events=raw.split('\\n\\n').filter(x=>/^event:/m.test(x)).map(frame=>({name:(frame.match(/^event:\\s*(.+)$/m)||[])[1],data:JSON.parse((frame.match(/^data:\\s*(.+)$/m)||[])[1])}));",
              "pm.test('Public correlation and event order',function(){pm.expect(events[0].name).to.equal('start');events.forEach(x=>{pm.expect(x.data.version).to.equal('v1');pm.expect(x.data.sessionId).to.equal(pm.variables.get('sessionId'));pm.expect(x.data.runId).to.equal(events[0].data.runId);});});",
              "pm.variables.set('runId',events[0].data.runId);",
              "pm.test(\"Controlled exact text\", function () { pm.expect(events.map(x=>x.name)).to.deep.equal(['start','token','token','done']);pm.expect(events.filter(x=>x.name==='token').map(x=>x.data.delta).join('')).to.equal('hello world'); });",
              "pm.sendRequest(pm.variables.get('fixtureUrl')+'?sessionId='+pm.variables.get('sessionId'), function(error,response){",
              "  pm.test('Database lookup succeeds',function(){pm.expect(error).to.equal(null);pm.expect(response.code).to.equal(200);});",
              "  const rows=response.json(); const row=rows.messages.filter(x=>String(x.run_id)===String(pm.variables.get('runId')) && x.sender_type==='ASSISTANT')[0];",
              "  pm.test('Persisted terminal and text',function(){pm.expect(row.status).to.equal('COMPLETED');pm.expect(row.content).to.equal(\"hello world\");pm.expect(rows.session.active_run_id).to.equal(null);});",
              "});"
            ]
          }
        }
      ]
    },
