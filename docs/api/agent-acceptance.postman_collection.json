              "pm.test('SSE MIME',function(){pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');});",
              "const raw=pm.response.text().replace(/\\r\\n/g,'\\n');",
              "const events=raw.split('\\n\\n').filter(x=>/^event:/m.test(x)).map(frame=>({name:(frame.match(/^event:\\s*(.+)$/m)||[])[1],data:JSON.parse((frame.match(/^data:\\s*(.+)$/m)||[])[1])}));",
              "pm.test('Public correlation and event order',function(){pm.expect(events[0].name).to.equal('start');events.forEach(x=>{pm.expect(x.data.version).to.equal('v1');pm.expect(x.data.sessionId).to.equal(pm.variables.get('sessionId'));pm.expect(x.data.runId).to.equal(events[0].data.runId);});});",
